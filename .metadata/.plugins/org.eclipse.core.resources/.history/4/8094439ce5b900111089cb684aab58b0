package application;

import javafx.fxml.FXML;
import javafx.scene.control.Label;

public class PlayerController {

    @FXML
    private Label statusLabel;

    @FXML
    private void play() {
        statusLabel.setText("Yayın başlatılıyor...");
    }

    @FXML
    private void stop() {
        statusLabel.setText("Yayın durduruldu.");
    }
}